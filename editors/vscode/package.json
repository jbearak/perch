{
  "name": "perch",
  "displayName": "Perch",
  "description": "Persistent terminal sessions that survive closed windows and dropped SSH connections.",
  "version": "0.1.0",
  "publisher": "jbearak",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbearak/perch"
  },
  "private": true,
  "engines": {
    "vscode": "^1.82.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onTerminalProfile:perch.persistentShell"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "perch",
          "title": "Perch",
          "icon": "media/perch.svg"
        }
      ]
    },
    "views": {
      "perch": [
        {
          "id": "perch.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "perch.refresh",
        "title": "Refresh",
        "category": "Perch",
        "icon": "$(refresh)"
      },
      {
        "command": "perch.open",
        "title": "Open",
        "category": "Perch",
        "icon": "$(terminal)"
      },
      {
        "command": "perch.newShell",
        "title": "New Persistent Shell",
        "category": "Perch"
      },
      {
        "command": "perch.kill",
        "title": "Kill",
        "category": "Perch",
        "icon": "$(trash)"
      },
      {
        "command": "perch.dismiss",
        "title": "Dismiss",
        "category": "Perch",
        "icon": "$(close)"
      },
      {
        "command": "perch.showLastOutput",
        "title": "Show Last Output",
        "category": "Perch",
        "icon": "$(output)"
      },
      {
        "command": "perch.showDetached",
        "title": "Show Detached Sessions",
        "category": "Perch"
      },
      {
        "command": "perch.showCommandLinePath",
        "title": "Show Command-Line Path",
        "category": "Perch"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "perch.refresh",
          "when": "view == perch.sessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "perch.open",
          "when": "view == perch.sessions && viewItem == perch.session.live",
          "group": "inline@0"
        },
        {
          "command": "perch.open",
          "when": "view == perch.sessions && viewItem == perch.session.live",
          "group": "0_open"
        },
        {
          "command": "perch.kill",
          "when": "view == perch.sessions && viewItem == perch.session.live",
          "group": "inline@1"
        },
        {
          "command": "perch.kill",
          "when": "view == perch.sessions && viewItem == perch.session.live",
          "group": "1_session"
        },
        {
          "command": "perch.showLastOutput",
          "when": "view == perch.sessions && viewItem == perch.session.ended",
          "group": "inline@1"
        },
        {
          "command": "perch.dismiss",
          "when": "view == perch.sessions && viewItem == perch.session.ended",
          "group": "inline@2"
        },
        {
          "command": "perch.showLastOutput",
          "when": "view == perch.sessions && viewItem == perch.session.ended",
          "group": "1_session@1"
        },
        {
          "command": "perch.dismiss",
          "when": "view == perch.sessions && viewItem == perch.session.ended",
          "group": "1_session@2"
        }
      ],
      "commandPalette": [
        {
          "command": "perch.kill",
          "when": "false"
        },
        {
          "command": "perch.dismiss",
          "when": "false"
        },
        {
          "command": "perch.showLastOutput",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Perch",
      "properties": {
        "perch.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "A `perch` binary to run instead of the one bundled with the extension. Empty uses the bundled binary. A leading `~/` means the home directory."
        },
        "perch.addToPath": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Append the directory of Perch's command-line copy to `PATH`, and set `PERCH_BIN`, in every new terminal in the editor, not only Perch's. A `perch` you installed yourself still wins. Run **Perch: Show Command-Line Path** to see the directory."
        },
        "perch.restoreTerminals": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Reopen the terminals of this workspace's Perch sessions when the window opens. A session attached in another window is left there."
        },
        "perch.shell": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          },
          "default": "",
          "scope": "machine",
          "markdownDescription": "The program the **Persistent shell** profile starts in a session: a path, or an array of a path and its arguments, such as `[\"/bin/zsh\", \"-l\"]`. Empty uses `$SHELL`, with `-l` on macOS to match VS Code's default there."
        },
        "perch.linkedEnvironment": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Environment variables whose values are socket paths, passed to `perch new --link-env`: each session sees a link that Perch re-points at the attached window's socket, so a reconnected session reaches the current window's agent or IPC socket. Changes apply to new sessions."
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "perch.persistentShell",
          "title": "Persistent shell",
          "icon": "terminal"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "check-deps": "node scripts/check-deps.mjs",
    "licenses": "node scripts/check-deps.mjs --write",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "node out/test/runTest.js",
    "test:core": "tsc -p tsconfig.test.json && mocha --recursive out/test/core"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "18.19.130",
    "@types/vscode": "1.82.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "mocha": "10.8.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "serialize-javascript": "7.1.4"
  }
}
